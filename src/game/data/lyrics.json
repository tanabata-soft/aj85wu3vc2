{
  "warae": [
    {
      "text": "Yeah! Alright! 1, 2, 3, Go!",
      "startMs": 7720,
      "endMs": 18100
    },
    {
      "text": "真っ黒な画面とにらめっこして",
      "startMs": 18100,
      "endMs": 22000
